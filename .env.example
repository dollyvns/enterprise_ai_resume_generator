# Application
APP_ENV=dev
APP_NAME=enterprise-ai-resume-generator
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT / Authentication
# Generate with: python scripts/generate_password_hash.py
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_USER_USERNAME=resume_user
APP_USER_PASSWORD_HASH=replace-with-generated-argon2-hash

# LLM
OPENAI_API_KEY=replace-me
# Use a model available to your account that supports structured output.
OPENAI_MODEL=gpt-5.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Agent workflow
MAX_REVIEW_REVISIONS=1
REVIEW_PASS_SCORE=85

# Observability
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-ai-resume-generator
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
